#!/usr/bin/env bash

# ==========================================
# RAZOR PAGES PROJECT MANAGER
# ==========================================

set -e

# Colours
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# ==========================================
# HELPER FUNCTIONS
# ==========================================

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

# ==========================================
# 1. CHECK AND INSTALL .NET SDK
# ==========================================

install_dotnet() {

    echo
    warning ".NET SDK is not installed or is not available in PATH."

    read -r -p "Would you like to install the latest stable .NET LTS SDK? (y/n): " answer

    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        error "Cannot continue without the .NET SDK."
        exit 1
    fi

    info "Downloading Microsoft's .NET installation script..."

    local installer
    installer=$(mktemp)

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL https://dot.net/v1/dotnet-install.sh -o "$installer"
    elif command -v wget >/dev/null 2>&1; then
        wget -q https://dot.net/v1/dotnet-install.sh -O "$installer"
    else
        error "Neither curl nor wget is installed."
        rm -f "$installer"
        exit 1
    fi

    info "Installing .NET LTS SDK..."

    bash "$installer" --channel LTS --install-dir "$HOME/.dotnet"

    rm -f "$installer"

    # Make .NET available in the current shell
    export DOTNET_ROOT="$HOME/.dotnet"
    export PATH="$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH"

    # Persist PATH for future Bash sessions
    if ! grep -Fq 'export DOTNET_ROOT="$HOME/.dotnet"' "$HOME/.bashrc" 2>/dev/null; then
        {
            echo
            echo '# .NET SDK'
            echo 'export DOTNET_ROOT="$HOME/.dotnet"'
            echo 'export PATH="$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH"'
        } >> "$HOME/.bashrc"
    fi

    success ".NET SDK installed."
}

# Check for an existing .NET installation
if ! command -v dotnet >/dev/null 2>&1; then
    if [[ -x "$HOME/.dotnet/dotnet" ]]; then
        export DOTNET_ROOT="$HOME/.dotnet"
        export PATH="$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH"
    else
        install_dotnet
    fi

fi

dotnet --version


# ==========================================
# 2. DETECT EXISTING .NET PROJECT OR SOLUTION
# ==========================================

find_dotnet_context() {

    local directory="$PWD"

    while true; do

        local project_file

        # echo "Checking directory: $directory" >&2

        # Check for C#, F# and VB.NET project files
        for project_file in "$directory"/*.csproj \
                            "$directory"/*.fsproj \
                            "$directory"/*.vbproj; do

            [[ -f "$project_file" ]] || continue

            echo "Found project file: $project_file" >&2

            # Check whether this is a Razor Pages project
            if [[ -d "$directory/Pages" ]] &&
                grep -Eq 'Microsoft\.NET\.Sdk\.(Web|Razor)' "$project_file"; then

                echo "razor|$directory|$project_file"
                return 0
            fi

            # A different .NET project was found
            echo "other|$directory|$project_file"
            return 0

        done

        # Check for solution files
        # for solution_file in "$directory"/*.sln "$directory"/*.slnx; do

        #     [[ -f "$solution_file" ]] || continue

        #     echo "Found solution file: $solution_file" >&2

        #     echo "solution|$directory|$solution_file"
        #     return 0

        # done

        # Stop when we reach the filesystem root
        [[ "$directory" == "/" ]] && break

        directory=$(dirname "$directory")

    done

    # echo "No .NET project or solution found." >&2

    return 1
}

# ==========================================
# 3. CHECK THE DETECTED PROJECT CONTEXT
# ==========================================

PROJECT_INFO=$(find_dotnet_context || true)

if [[ -n "$PROJECT_INFO" ]]; then

    PROJECT_TYPE="${PROJECT_INFO%%|*}"
    REMAINING="${PROJECT_INFO#*|}"

    PROJECT_ROOT="${REMAINING%%|*}"
    PROJECT_FILE="${REMAINING#*|}"
    echo "Project type: $PROJECT_TYPE"

    echo

    case "$PROJECT_TYPE" in

        razor)

            success "Razor Pages project detected!"

            info "Project: $(basename "$PROJECT_FILE")"
            info "Root: $PROJECT_ROOT"

            cd "$PROJECT_ROOT"

            success "Navigated to project root."

            echo
            info "Launching Razor Pages project..."

            dotnet run --project "$PROJECT_FILE"

            exit 0
            ;;

        other)

            error "An existing .NET project was detected!"
            info "Project: $(basename "$PROJECT_FILE")"
            info "Location: $PROJECT_ROOT"

            echo
            warning "Project creation is not allowed inside another .NET project."
            warning "Navigate outside the existing project before creating a new one."

            exit 1
            ;;

        solution)

            error "An existing .NET solution was detected!"
            info "Solution: $(basename "$PROJECT_FILE")"
            info "Location: $PROJECT_ROOT"

            echo
            warning "Project creation is not allowed inside an existing solution directory."
            warning "Navigate outside the solution before creating a new project."

            exit 1
            ;;

    esac

fi

# ==========================================
# 4. NO EXISTING PROJECT OR SOLUTION FOUND
# ==========================================

echo
warning "You are not currently inside a .NET project or solution."

info "Current directory: $PWD"

echo
read -r -p "Would you like to create a Razor Pages project here? (y/n): " create_answer

if [[ ! "$create_answer" =~ ^[Yy]$ ]]; then
    warning "Navigate to a suitable directory and run this script again."
    exit 0
fi

# ==========================================
# 5. ASK FOR PROJECT NAME
# ==========================================

DEFAULT_NAME=$(basename "$PWD" | sed 's/[^a-zA-Z0-9_.-]/_/g')
echo "Default project name based on current directory: $DEFAULT_NAME"

if [[ -z "$DEFAULT_NAME" || "$DEFAULT_NAME" == "." ]]; then
    DEFAULT_NAME="MyRazorApp"
    echo "Using default project name: $DEFAULT_NAME"
fi

echo
read -r -p "Enter project name [$DEFAULT_NAME]: " PROJECT_NAME

PROJECT_NAME=${PROJECT_NAME:-$DEFAULT_NAME}

# ==========================================
# 6. ASK FOR PROJECT TYPE
# ==========================================

echo
echo "Choose the type of Razor Pages project:"
echo
echo "1. Regular Razor Pages project"
echo "2. Razor Pages project with Authentication"
echo

read -r -p "Enter your choice (1 or 2): " PROJECT_TYPE

case "$PROJECT_TYPE" in

    1)
        info "Creating regular Razor Pages project..."

        dotnet new webapp \
            -n "$PROJECT_NAME" \
            -o "$PWD"
        ;;

    2)
        info "Creating Razor Pages project with Authentication..."

        dotnet new webapp \
            -n "$PROJECT_NAME" \
            --auth Individual \
            -o "$PWD"
        ;;

    *)
        error "Invalid selection."
        exit 1
        ;;

esac

# ==========================================
# 7. LAUNCH NEW PROJECT
# ==========================================

PROJECT_FILE="$PWD/$PROJECT_NAME.csproj"
echo "Project file created at: $PROJECT_FILE"

if [[ ! -f "$PROJECT_FILE" ]]; then
    error "Project creation could not be verified."
    exit 1
fi

success "Razor Pages project created successfully!"

echo
info "Launching $PROJECT_NAME..."

dotnet run --project "$PROJECT_FILE"
