#!/usr/bin/env bash
#
# Ubuntu all-in-one cleanup script
#
#   Part 1: System cleanup (sudo)  - runs your original commands unchanged in concept
#   Part 2: Extra system cleanup   - more space reclaimed (asks first)
#   Part 3: Home cleanup           - per-item confirmation, never touches projects,
#                                    downloads, documents, SDKs, node_modules, venvs,
#                                    Gradle or app settings
#
# Usage:
#   ./cleanup-all.sh            runs everything with no prompts
#   ./cleanup-all.sh --ask      ask before each step (interactive)
#   ./cleanup-all.sh --cargo    also clear ~/.cargo/registry/cache (optional)
#   ./cleanup-all.sh --large    also list files larger than 1 GB (report only, slow)
#   ./cleanup-all.sh --report   only show where the space is going, delete nothing
#

set -o pipefail

HOME_DIR="${HOME}"
CACHE_DIR="${HOME_DIR}/.cache"
ASSUME_YES=1
REPORT_ONLY=0
SHOW_LARGE=0
CLEAN_CARGO=0

for arg in "$@"; do
    case "$arg" in
        -y|--yes)    ASSUME_YES=1 ;;
        -a|--ask)    ASSUME_YES=0 ;;
        -l|--large)  SHOW_LARGE=1 ;;
        -c|--cargo)  CLEAN_CARGO=1 ;;
        -r|--report) REPORT_ONLY=1 ;;
        -h|--help)   sed -n '2,19p' "$0"; exit 0 ;;
        *) echo "Unknown option: $arg"; exit 1 ;;
    esac
done

# ---------- helpers ----------
bold()   { printf '\033[1m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
red()    { printf '\033[31m%s\033[0m\n' "$*"; }
have()   { command -v "$1" >/dev/null 2>&1; }

confirm() {
    local answer
    if [[ $ASSUME_YES -eq 1 ]]; then
        echo "-> $1 (auto-yes)"
        return 0
    fi
    read -r -p "$1 [y/N]: " answer
    [[ "$answer" =~ ^([yY]|[yY][eE][sS])$ ]]
}

human_size() { du -sh "$1" 2>/dev/null | awk '{print $1}'; }

# true if any of the given exact process names is running
is_running() {
    local name
    for name in "$@"; do
        pgrep -x "$name" >/dev/null 2>&1 && return 0
    done
    return 1
}

used_kb() { df --output=used -k / | tail -1 | tr -d ' '; }

# ---------- reports ----------
show_storage() {
    bold "=== Filesystem space ==="
    df -h / "$HOME_DIR" 2>/dev/null | awk '!seen[$0]++'
    printf '\n'
    bold "=== Largest directories in your home folder ==="
    # du -h --max-depth=1 "$HOME_DIR" 2>/dev/null | sort -h | tail -25
    stdbuf -oL du -h --max-depth=1 "$HOME_DIR" 2>/dev/null |
    while IFS= read -r line; do
        echo "Processed: $line"
    done
    printf '\n'
    bold "=== Largest cache directories ==="
    if [[ -d "$CACHE_DIR" ]]; then
        # du -h --max-depth=1 "$CACHE_DIR" 2>/dev/null | sort -h | tail -25
        stdbuf -oL du -h --max-depth=1 "$CACHE_DIR" 2>/dev/null |
        while IFS= read -r line; do
            echo "Processed: $line"
        done
    else
        echo "No ~/.cache directory found."
    fi
    printf '\n'
    bold "=== Developer-tool directories ==="
    local path
    for path in "$HOME_DIR/.npm" "$HOME_DIR/.gradle" "$HOME_DIR/.android" \
                "$HOME_DIR/Android" "$HOME_DIR/.nuget" "$HOME_DIR/.vscode" \
                "$HOME_DIR/.cargo" "$HOME_DIR/.rustup" "$HOME_DIR/.m2" \
                "$HOME_DIR/.local/share/pnpm" "$HOME_DIR/go" "$HOME_DIR/.conda" \
                "$HOME_DIR/miniconda3" "$HOME_DIR/anaconda3"; do
        [[ -e "$path" ]] && du -sh "$path" 2>/dev/null
    done
    printf '\n'
    bold "=== Largest system directories (needs sudo) ==="
    sudo du -h --max-depth=1 /var 2>/dev/null | sort -h | tail -10
    printf '\n'
    if have docker; then
        bold "=== Docker disk usage ==="
        sudo docker system df 2>/dev/null
        printf '\n'
    fi
}

show_large_files() {
    bold "=== Files larger than 1 GB in your home (report only) ==="
    echo "This may take a little while..."
    find "$HOME_DIR" -xdev -type f -size +1G -printf '%s\t%p\n' 2>/dev/null \
        | sort -nr \
        | while IFS=$'\t' read -r bytes file; do
            awk -v b="$bytes" 'BEGIN { printf "%.2f GB\t", b/1024/1024/1024 }'
            printf '%s\n' "$file"
        done
    echo "No files are deleted by this report."
}

# =====================================================================
# PART 1: SYSTEM CLEANUP (your original commands)
# =====================================================================
system_cleanup() {
    bold "===== Part 1: System Cleanup ====="

    echo "[1/8] Cleaning APT cache..."
    sudo apt clean
    sudo apt autoclean
    sudo apt autoremove -y

    echo "[2/8] Cleaning journal logs (keeping 3 days)..."
    sudo journalctl --vacuum-time=3d

    echo "[3/8] Cleaning system /tmp..."
    sudo rm -rf /tmp/*

    echo "[4/8] Cleaning user /tmp..."
    rm -rf ~/tmp/* 2>/dev/null || true

    echo "[5/8] Cleaning thumbnail cache..."
    rm -rf ~/.cache/thumbnails/*

    echo "[6/8] Cleaning Snap old revisions..."
    if have snap; then
        sudo snap set system refresh.retain=2
        # Remove all disabled (old) revisions.
        # NOTE: each revision must be removed with --revision, otherwise
        # "snap remove name revision" treats the revision number as a snap name.
        local old_snaps
        old_snaps="$(snap list --all 2>/dev/null | awk '/disabled/{print $1, $3}')"
        if [[ -n "$old_snaps" ]]; then
            while read -r name rev; do
                [[ -z "$name" ]] && continue
                echo "  Removing $name (revision $rev)"
                sudo snap remove --purge "$name" --revision="$rev"
            done <<< "$old_snaps"
            echo "Old Snap revisions removed."
        else
            echo "No old Snap revisions to remove."
        fi
    else
        echo "snap not installed; skipping."
    fi

    echo "[7/8] Cleaning Docker (if installed)..."
    if have docker; then
        sudo docker system prune -af
    else
        echo "docker not installed; skipping."
    fi

    echo "[8/8] Checking for orphaned packages..."
    if have deborphan; then
        deborphan | xargs -r sudo apt purge -y 2>/dev/null || true
    else
        yellow "deborphan not installed (sudo apt install deborphan); skipping."
    fi
}

# =====================================================================
# PART 2: EXTRA SYSTEM CLEANUP (additional space savers)
# =====================================================================
extra_system_cleanup() {
    bold "===== Part 2: Extra system cleanup ====="

    # Residual config files of removed packages (dpkg state 'rc')
    local rc_pkgs
    rc_pkgs="$(dpkg -l 2>/dev/null | awk '/^rc/{print $2}')"
    if [[ -n "$rc_pkgs" ]]; then
        echo "Leftover config of already-removed packages:"
        echo "$rc_pkgs" | sed 's/^/  /'
        if confirm "Purge these leftover package configs?"; then
            echo "$rc_pkgs" | xargs -r sudo apt purge -y
        fi
    else
        echo "No leftover package configs."
    fi

    # Old rotated/compressed logs and crash dumps
    echo
    echo "Old rotated logs (*.gz, *.old, *.[0-9]) in /var/log: $(sudo du -ch /var/log/*.gz /var/log/*.old /var/log/*.[0-9] 2>/dev/null | tail -1 | awk '{print $1}')"
    if confirm "Delete rotated/compressed logs in /var/log?"; then
        sudo find /var/log -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' -o -name '*.[0-9].log' \) -delete 2>/dev/null
        green "Rotated logs removed."
    fi

    if [[ -d /var/crash ]] && [[ -n "$(ls -A /var/crash 2>/dev/null)" ]]; then
        echo "/var/crash: $(sudo du -sh /var/crash 2>/dev/null | awk '{print $1}')"
        if confirm "Delete crash reports in /var/crash?"; then
            sudo rm -rf /var/crash/*
        fi
    fi

    if [[ -d /var/lib/systemd/coredump ]] && [[ -n "$(sudo ls -A /var/lib/systemd/coredump 2>/dev/null)" ]]; then
        echo "Core dumps: $(sudo du -sh /var/lib/systemd/coredump 2>/dev/null | awk '{print $1}')"
        if confirm "Delete systemd core dumps?"; then
            sudo rm -rf /var/lib/systemd/coredump/*
        fi
    fi

    # Stale files in /var/tmp (older than 30 days only)
    echo
    echo "Files in /var/tmp older than 30 days: $(sudo find /var/tmp -type f -mtime +30 -printf '%s\n' 2>/dev/null | awk '{s+=$1} END {printf "%.1f MB", s/1024/1024}')"
    if confirm "Delete files in /var/tmp older than 30 days?"; then
        sudo find /var/tmp -type f -mtime +30 -delete 2>/dev/null
    fi

    # Flatpak unused runtimes
    if have flatpak; then
        echo
        echo "Flatpak unused runtimes/extensions will be removed (apps are kept)."
        if confirm "Run 'flatpak uninstall --unused'?"; then
            flatpak uninstall --unused -y
        fi
    fi

    # Snap per-app caches
    if [[ -d "$HOME_DIR/snap" ]]; then
        echo
        local snap_cache_total
        snap_cache_total="$(du -shc "$HOME_DIR"/snap/*/common/.cache 2>/dev/null | tail -1 | awk '{print $1}')"
        echo "Snap app caches (~/snap/*/common/.cache): ${snap_cache_total:-0}"
        if confirm "Clear snap app caches?"; then
            rm -rf "$HOME_DIR"/snap/*/common/.cache/* 2>/dev/null
        fi
    fi
}

# =====================================================================
# PART 3: HOME CLEANUP (per-item confirmation)
# =====================================================================
clean_trash() {
    bold "--- Trash ---"
    local trash="$HOME_DIR/.local/share/Trash"
    if [[ -d "$trash" ]]; then
        echo "Trash size: $(human_size "$trash")"
        if confirm "Empty the Trash permanently?"; then
            rm -rf -- "$trash/files/"* "$trash/info/"* 2>/dev/null
            green "Trash emptied."
        fi
    else
        echo "No Trash directory found."
    fi
}

clean_npm_cache() {
    bold "--- npm / yarn / pnpm caches ---"
    if have npm; then
        echo "npm cache: $(human_size "$HOME_DIR/.npm")"
        if confirm "Run 'npm cache verify' (safe) ?"; then
            npm cache verify
        fi
        if confirm "Fully clear the npm cache ('npm cache clean --force')?"; then
            npm cache clean --force
        fi
    fi
    if have yarn; then
        if confirm "Run 'yarn cache clean'?"; then
            yarn cache clean
        fi
    fi
    if have pnpm; then
        if confirm "Run 'pnpm store prune' (removes unreferenced packages only)?"; then
            pnpm store prune
        fi
    fi
}

clean_pip_cache() {
    bold "--- pip download cache ---"
    local pip_cmd=""
    if have pip; then pip_cmd="pip"
    elif have pip3; then pip_cmd="pip3"
    fi
    if [[ -z "$pip_cmd" ]]; then
        yellow "pip/pip3 not found; skipping."
        return
    fi
    "$pip_cmd" cache info 2>/dev/null || true
    echo "This removes only pip's download/wheel cache, not installed packages or venvs."
    if confirm "Run '$pip_cmd cache purge'?"; then
        "$pip_cmd" cache purge
    fi
}

clean_conda_cache() {
    if have conda; then
        bold "--- conda caches ---"
        if confirm "Run 'conda clean --all -y' (unused packages/tarballs/caches)?"; then
            conda clean --all -y
        fi
    fi
}

clean_go_cache() {
    if have go; then
        bold "--- Go build cache ---"
        echo "Go build cache: $(human_size "$(go env GOCACHE 2>/dev/null)")"
        if confirm "Run 'go clean -cache'?"; then
            go clean -cache
        fi
    fi
}

clean_cargo_cache() {
    local reg="$HOME_DIR/.cargo/registry/cache"
    if [[ -d "$reg" ]]; then
        bold "--- Cargo downloaded crate archives ---"
        echo "$reg: $(human_size "$reg")  (re-downloaded on demand)"
        if confirm "Remove ~/.cargo/registry/cache?"; then
            rm -rf -- "$reg"
        fi
    fi
}

clean_browser_caches() {
    bold "--- Browser caches ---"
    # Chrome
    local chrome_cache="$CACHE_DIR/google-chrome/Default"
    if [[ -d "$chrome_cache" ]]; then
        if is_running chrome google-chrome; then
            yellow "Chrome is running. Close it fully and re-run to clean its cache."
        else
            echo "Chrome cache: $(human_size "$chrome_cache/Cache") + code cache $(human_size "$chrome_cache/Code Cache")"
            echo "Only temporary Cache and Code Cache are removed; profile, bookmarks, passwords and history are untouched."
            if confirm "Remove Chrome temporary caches?"; then
                rm -rf -- "$chrome_cache/Cache" "$chrome_cache/Code Cache"
                green "Chrome caches cleared."
            fi
        fi
    fi
    # Chromium
    local chromium_cache="$CACHE_DIR/chromium/Default"
    if [[ -d "$chromium_cache" ]]; then
        if is_running chromium chromium-browser; then
            yellow "Chromium is running. Close it fully and re-run."
        elif confirm "Remove Chromium temporary caches?"; then
            rm -rf -- "$chromium_cache/Cache" "$chromium_cache/Code Cache"
        fi
    fi
    # Firefox (deb + snap locations)
    local ff_dirs=("$CACHE_DIR/mozilla/firefox" "$HOME_DIR/snap/firefox/common/.cache/mozilla/firefox")
    local d
    for d in "${ff_dirs[@]}"; do
        if [[ -d "$d" ]]; then
            if is_running firefox firefox-bin; then
                yellow "Firefox is running. Close it fully and re-run."
                break
            fi
            echo "Firefox cache ($d): $(human_size "$d")"
            if confirm "Remove Firefox cache in $d?"; then
                find "$d" -maxdepth 2 -type d -name cache2 -exec rm -rf {} + 2>/dev/null
                green "Firefox cache cleared."
            fi
        fi
    done
}

clean_vscode_cpp_cache() {
    bold "--- VS Code C/C++ extension cache ---"
    local cpp_cache="$CACHE_DIR/vscode-cpptools"
    if [[ ! -d "$cpp_cache" ]]; then
        echo "Not found; skipping."
        return
    fi
    if is_running code; then
        yellow "VS Code is running. Close it completely before cleaning."
        return
    fi
    echo "Size: $(human_size "$cpp_cache")  (rebuilt on next use, may be slower once)"
    if confirm "Remove ~/.cache/vscode-cpptools?"; then
        rm -rf -- "$cpp_cache"
        green "Cleared."
    fi
}

clean_android_studio_cache() {
    bold "--- Android Studio generated caches ---"
    local found=0 dir
    for dir in "$CACHE_DIR"/Google/AndroidStudio*/caches; do
        [[ -d "$dir" ]] || continue
        found=1
        # Match Android Studio specifically (not any random Java process)
        if pgrep -f 'android-studio|AndroidStudio|com\.google\.android\.studio' >/dev/null 2>&1; then
            yellow "Android Studio appears to be running. Close it before cleaning."
            continue
        fi
        echo "$dir: $(human_size "$dir")  (the 'index' directory is left untouched)"
        if confirm "Remove $dir?"; then
            rm -rf -- "$dir"
            green "Cleared."
        fi
    done
    [[ $found -eq 0 ]] && echo "No Android Studio cache directories found."
}

clean_misc_caches() {
    bold "--- Other safe user caches ---"
    local item
    for item in "$CACHE_DIR/pip" "$CACHE_DIR/yarn" "$CACHE_DIR/typescript" \
                "$CACHE_DIR/node-gyp" "$CACHE_DIR/electron" "$CACHE_DIR/fontconfig" \
                "$CACHE_DIR/mesa_shader_cache" "$CACHE_DIR/Microsoft" \
                "$CACHE_DIR/JetBrains" "$CACHE_DIR/ms-playwright" \
                "$CACHE_DIR/puppeteer" "$CACHE_DIR/trivy"; do
        if [[ -d "$item" ]]; then
            echo "$item: $(human_size "$item")"
        fi
    done
    echo "All of the above are regenerated automatically when needed."
    if confirm "Remove the listed cache directories above?"; then
        for item in "$CACHE_DIR/pip" "$CACHE_DIR/yarn" "$CACHE_DIR/typescript" \
                    "$CACHE_DIR/node-gyp" "$CACHE_DIR/electron" "$CACHE_DIR/fontconfig" \
                    "$CACHE_DIR/mesa_shader_cache" "$CACHE_DIR/Microsoft" \
                    "$CACHE_DIR/JetBrains" "$CACHE_DIR/ms-playwright" \
                    "$CACHE_DIR/puppeteer" "$CACHE_DIR/trivy"; do
            [[ -d "$item" ]] && rm -rf -- "$item"
        done
        green "Done."
    fi
}

inspect_vscode_cache_dir() {
    local d="$CACHE_DIR/Code"
    if [[ -d "$d" ]]; then
        bold "--- ~/.cache/Code (inspect only, NOT removed) ---"
        echo "Total: $(human_size "$d")"
        du -sh "$d"/* 2>/dev/null | sort -h | tail -10
        echo "Review the above and delete specific subfolders manually if you are sure."
    fi
}

home_cleanup() {
    bold "===== Part 3: Home cleanup ====="
    clean_trash;                echo
    clean_npm_cache;            echo
    clean_pip_cache;            echo
    clean_conda_cache;          echo
    clean_go_cache;             echo
    [[ $CLEAN_CARGO -eq 1 ]] && { clean_cargo_cache; echo; }
    clean_browser_caches;       echo
    clean_vscode_cpp_cache;     echo
    clean_android_studio_cache; echo
    clean_misc_caches; echo
    inspect_vscode_cache_dir
}

# =====================================================================
# MAIN
# =====================================================================
main() {
    bold "Ubuntu All-in-One Cleanup"
    echo "Home directory: $HOME_DIR"
    echo

    # Cache sudo credentials once
    if ! sudo -v; then
        red "sudo is required for the system cleanup sections."
        exit 1
    fi

    local before after
    before="$(used_kb)"

    show_storage

    if [[ $REPORT_ONLY -eq 1 ]]; then
        show_large_files
        echo
        green "Report-only mode: nothing was deleted."
        exit 0
    fi

    if [[ $SHOW_LARGE -eq 1 ]]; then
        show_large_files
        echo
    fi

    if confirm "Run Part 1: system cleanup (apt, journal 3d, /tmp, snap revisions, docker prune -af, orphans)?"; then
        system_cleanup
        echo
    else
        echo "Skipped Part 1."
    fi

    if confirm "Run Part 2: extra system cleanup (leftover configs, rotated logs, crash dumps, flatpak, ...)?"; then
        extra_system_cleanup
        echo
    else
        echo "Skipped Part 2."
    fi

    if confirm "Run Part 3: home cache cleanup (asks before each item)?"; then
        home_cleanup
        echo
    else
        echo "Skipped Part 3."
    fi

    after="$(used_kb)"
    bold "===== Final storage status ====="
    df -h /
    awk -v b="$before" -v a="$after" 'BEGIN { printf "Approx. space freed: %.2f GB\n", (b-a)/1024/1024 }'
    green "Finished. Your projects, documents, downloads, venvs, node_modules and ~/.gradle were not modified."
}

main "$@"
