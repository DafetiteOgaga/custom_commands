#!/usr/bin/env bash

# ---------------------------
# 1. SELECT PROFILE
# ---------------------------
echo "Choose compression profile:"
echo "1) Carousel  (max 100kb)"
echo "2) Thumbnail (max 40kb)"
echo "3) Custom"
echo ""
echo "Note: this command compress and/or resizes all jpg/jpeg/png files in the dir where it is invoked."
echo "q - Quit"
read -p "Enter option (1, 2 or 3): " option

if [[ "$option" =~ ^[qQ]$ ]]; then
	echo ""
    echo "Quitting..."
    exit 0
fi

if [ "$option" == "1" ]; then
    MAX_SIZE=100
    PROFILE="carousel"
    MAX_W=1280
    MAX_H=720
elif [ "$option" == "2" ]; then
    MAX_SIZE=40
    PROFILE="thumbnail"
    MAX_W=480
    MAX_H=360
elif [ "$option" == "3" ]; then
    PROFILE="custom"
    read -p "Enter desired max file size in KB: " MAX_SIZE
    read -p "Enter max WIDTH (enter 0 for auto): " MAX_W
    read -p "Enter max HEIGHT (enter 0 for auto): " MAX_H
else
    echo "Invalid option."
    exit 1
fi

# ---------------------------
# VALIDATE INPUTS TO BE NUMBERS
# ---------------------------
if ! [[ "$MAX_SIZE" =~ ^[0-9]+$ ]]; then
    echo "Invalid size. Must be a number."
    exit 1
fi
if ! [[ "$MAX_W" =~ ^[0-9]+$ ]]; then
    echo "Invalid width. Must be a number."
    exit 1
fi
if ! [[ "$MAX_H" =~ ^[0-9]+$ ]]; then
    echo "Invalid height. Must be a number."
    exit 1
fi

# ---------------------------
# 2. CREATE UNIQUE OUTPUT DIR
# ---------------------------
BASE_DIR="output_${PROFILE}"
OUT_DIR="$BASE_DIR"
i=1

while [ -d "$OUT_DIR" ]; do
    OUT_DIR="${BASE_DIR}_${i}"
    ((i++))
done

mkdir "$OUT_DIR"
echo "📁 Saving images to: $OUT_DIR"

# ---------------------------
# 3. PROCESS ALL IMAGES
# ---------------------------
for img in *.{jpg,jpeg,png,JPG,JPEG,PNG}; do
    [ -e "$img" ] || continue  # skip if no match
    
    echo "⚙️ Processing: $img"

    # Copy first
    output="$OUT_DIR/$img"
    cp "$img" "$output"

    # Get original dimensions
    orig_width=$(identify -format "%w" "$output")
    orig_height=$(identify -format "%h" "$output")

    # If custom and width or height is 0, keep aspect ratio
    if [ "$option" == "3" ]; then
        if [ "$MAX_W" -eq 0 ] && [ "$MAX_H" -eq 0 ]; then
            MAX_W=$orig_width
            MAX_H=$orig_height
        elif [ "$MAX_W" -eq 0 ]; then
            MAX_W=$(( orig_width * MAX_H / orig_height ))
        elif [ "$MAX_H" -eq 0 ]; then
            MAX_H=$(( orig_height * MAX_W / orig_width ))
        fi
    fi

    # -------------------------------
    # RESIZE IMAGES
    # -------------------------------
    if [ "$option" == "3" ]; then
        # Custom profile: always resize to target dimensions
        mogrify -resize "${MAX_W}x${MAX_H}" "$output"
    else
        # Carousel / Thumbnail: resize only if bigger (no enlarging)
        if [ "$orig_width" -gt "$MAX_W" ] || [ "$orig_height" -gt "$MAX_H" ]; then
            mogrify -resize "${MAX_W}x${MAX_H}>" "$output"
        else
            echo "ℹ️ Skipping resize: image smaller than target dimensions"
        fi
    fi

    # Reduce size until under MAX_SIZE KB
    quality=90
    while [ $(du -k "$output" | cut -f1) -gt $MAX_SIZE ] && [ $quality -gt 10 ]; do
        mogrify -quality $quality "$output"
        quality=$((quality - 5))
    done

    final_size=$(du -k "$output" | cut -f1)
    echo "✅ Final size: ${final_size}kb"
done

echo "🎉 All images processed successfully!"
